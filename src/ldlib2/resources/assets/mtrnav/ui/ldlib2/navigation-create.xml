<?xml version="1.0" encoding="UTF-8"?>
<ldlib2-ui>
  <stylesheet location="ldlib2:lss/mc.lss"/>
  <style><![CDATA[
    * { font: mtrnav:ui_smooth; font-size: 9; text-color: #eeeeee; text-shadow: false; }
    #workspace { width: 520; height: 360; padding-all: 12; gap-all: 4; background: built-in(ui-mc:RECT_2); }
    .row { flex-direction: row; gap-all: 4; align-items: center; flex-shrink: 0; }
    .grow { flex: 1; min-width: 0; min-height: 0; }
    .titlebar { height: 24; padding-horizontal: 4; background: built-in(ui-mc:RECT_2); }
    .muted { text-color: #bbbbbb; }
    .brass { text-color: #dedede; }
    label { height: 12; flex-shrink: 0; text-wrap: hover_roll; }
    text { adaptive-height: true; text-wrap: wrap; }
    button { height: 20; min-width: 18; flex-shrink: 0; }
    button .__button_text__ { text-color: #202020; vertical-align: center; }
    button:host { base-background: built-in(ui-mc:RECT_BORDER); hover-background: built-in(ui-mc:RECT_3); pressed-background: built-in(ui-mc:RECT_INVERSE); }
    .primary:host, .selected:host { base-background: built-in(ui-mc:RECT_BORDER) color(#7abf55); hover-background: built-in(ui-mc:RECT_3) color(#8bd66a); }
    .primary .__button_text__, .selected .__button_text__ { text-color: #ffffff; }
    .station { gap-all: 2; flex: 1; min-width: 0; }
    text-field:host { height: 20; padding-all: 4; background: built-in(ui-mc:RECT_BLACK); text-color: #f0f0f0; cursor-color: #f0f0f0; }
    #query { height: 42; }
    #toolbar { height: 20; }
    #body { flex: 1; min-height: 0; gap-all: 8; flex-direction: row; }
    #results { width: 152; min-height: 0; gap-all: 4; }
    .inset { background: built-in(ui-mc:RECT_BLACK); padding-all: 4; gap-all: 4; }
    .__scroller_view_view-port__ { background: empty; padding-all: 0; }
    .__scroller_view_view-container__ { gap-all: 4; }
    .journey { height: 32; gap-all: 2; padding-all: 4; flex-direction: column; align-items: stretch; }
    .journey label { height: 10; width: 100%; text-color: #eeeeee; horizontal-align: left; }
    .journey:host { base-background: built-in(ui-mc:RECT_2); hover-background: built-in(ui-mc:RECT_3); }
    .journey.selected:host { base-background: built-in(ui-mc:RECT_BORDER) color(#7abf55); }
    .detail-text { padding-all: 4; gap-all: 8; }
    #footer { height: 20; }
    #compact-tabs, #summary { display: none; }
    .compact #query, .compact #toolbar { display: none; }
    .compact #summary, .compact #compact-tabs { display: flex; height: 20; }
    .compact #results { width: 100%; flex: 1; }
    .compact #detail { display: none; }
    .compact.show-detail #results { display: none; }
    .compact.show-detail #detail { display: flex; }
  
    #workspace { background: sprite(mtrnav:textures/gui/create/stock_keeper.png,22,48,212,20,12,4,12,4); }
    .titlebar { background: sprite(mtrnav:textures/gui/create/stock_keeper.png,37,0,182,16,3,3,3,3); }
    .titlebar label { text-color: #42352b; }
    button:host { base-background: sprite(mtrnav:textures/gui/create/widgets.png,0,0,18,18,3,3,3,3); hover-background: sprite(mtrnav:textures/gui/create/widgets.png,18,0,18,18,3,3,3,3); pressed-background: sprite(mtrnav:textures/gui/create/widgets.png,36,0,18,18,3,3,3,3); }
    button .__button_text__ { text-color: #eeeeee; }
    .primary:host, .selected:host { base-background: sprite(mtrnav:textures/gui/create/widgets.png,72,0,18,18,3,3,3,3); hover-background: sprite(mtrnav:textures/gui/create/widgets.png,54,0,18,18,3,3,3,3); }
    button.__disabled__:host { base-background: sprite(mtrnav:textures/gui/create/widgets.png,90,0,18,18,3,3,3,3); }
    text-field:host { background: group(rect(#f7eed9),border(1,#4a2d31)); text-color: #39362b; cursor-color: #39362b; }
    .inset { background: group(sprite(mtrnav:textures/gui/create/schedule.png,32,32,32,32,0,0,0,0,#ffffff,repeat),border(1,#161616)); }
    .journey:host { base-background: group(rect(#dd30332f),border(1,#6b6d5c)); hover-background: group(rect(#dd414c3b),border(1,#c8aa72)); }
    .journey.selected:host { base-background: group(rect(#dd3d4b36),border(1,#dec58d)); }
    .brass { text-color: #dec58d; }
  ]]></style>
  <root id="workspace">
    <element class="row titlebar">
      <label class="grow">站间物语 · 界面对照</label>
      <button id="theme" text="原版控件" style="width: 68"/>
      <button id="font" text="B 清晰中文" style="width: 68"/>
      <button id="editor" text="编辑界面" style="width: 56"/>
      <button id="close" text="×" style="width: 18; height: 18"/>
    </element>
    <element id="query" class="row">
      <element class="station"><label class="muted">起点</label><text-field id="origin" value="南苑 Nanyuan"/></element>
      <button id="swap" text="⇄" style="width: 18; height: 18; margin-top: 12"/>
      <element class="station"><label class="muted">终点</label><text-field id="destination" value="滨海北 Binhai North"/></element>
    </element>
    <element id="toolbar" class="row">
      <button id="stations" text="全部车站" style="width: 76"/>
      <button id="walking" text="步行换乘" style="width: 76"/>
      <label class="grow muted">测试数据 · 非实时查询</label>
      <button id="scene" text="切换场景" style="width: 72"/>
      <button id="search" text="查找路线" class="primary" style="width: 76"/>
    </element>
    <element id="summary" class="row"><label id="summary-label" class="grow">南苑 → 滨海北</label><button id="compact-query" text="修改站点" style="width: 66"/></element>
    <element id="compact-tabs" class="row"><button id="show-list" text="行程方案" style="width: 76"/><button id="show-detail" text="行程详情" style="width: 76"/></element>
    <element id="body">
      <element id="results">
        <label class="brass" id="result-count">行程方案 · 5</label>
        <scroller-view id="journeys" class="grow inset">
          <button id="journey-0" class="journey" text=""><label>直达 · 28 分钟</label><label class="muted">1 号线 Local · 无需换乘</label></button>
          <button id="journey-1" class="journey" text=""><label>换乘 1 次 · 31 分钟</label><label class="muted">Local → Airport Express</label></button>
          <button id="journey-2" class="journey" text=""><label>换乘 1 次 · 36 分钟</label><label class="muted">Local → Riverside</label></button>
          <button id="journey-3" class="journey" text=""><label>换乘 2 次 · 42 分钟</label><label class="muted">Local → Central → North</label></button>
          <button id="journey-4" class="journey" text=""><label>步行换乘 · 45 分钟</label><label class="muted">Local → 步行 4 分钟 → North</label></button>
          <text id="empty-list" visible="false">没有找到可用方案</text>
        </scroller-view>
      </element>
      <element id="detail" class="grow" style="gap-all: 4">
        <label class="brass">行程详情</label>
        <scroller-view class="grow inset">
          <element class="detail-text">
            <text id="route-title">直达 · 预计 28 分钟</text>
            <text id="departure" class="muted">下一班 08:12 · 1 站台</text>
            <text id="origin-detail">南苑 Nanyuan</text>
            <text class="muted">途经 6 站 · 测试路线</text>
            <text id="destination-detail">滨海北 Binhai North</text>
            <text id="arrival" class="muted">08:40 到达 · 2 站台</text>
            <text id="state-note" class="muted">测试数据，不会发送查询或开始真实导航。</text>
          </element>
        </scroller-view>
      </element>
    </element>
    <element id="footer" class="row">
      <label id="status" class="grow muted">F5 风格 · F6 字体 · F7 场景 · F9 编辑</label>
      <button id="navigate" class="primary" text="开始导航" style="width: 96"/>
    </element>
  </root>
</ldlib2-ui>
